# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# user uploads (local dev only — production mounts a persistent volume here)
/public/uploads/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
Thumbs.db

# Playwright — e2e/.server.* are per-run artifacts (log, spawned server PID),
# .auth-state.json is a live session cookie, none belong in the repo.
/e2e/.server.log
/e2e/.server.pid
/e2e/.auth-state.json
/test-results/
/playwright-report/
/blob-report/
