# Copy to .env.local for development. Never commit the real file.

DATABASE_URL=postgresql://clhub:clhub@localhost:5432/clhub

# Random 32+ char string signing sessions — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Resend (https://resend.com) — used for magic links and booking notification emails.
RESEND_API_KEY=

# Sender address. Must belong to a domain verified in Resend.
MAIL_FROM=club@puzzpok.fr

# Base URL the app is served from, used to build absolute links in emails.
APP_URL=http://localhost:3000
