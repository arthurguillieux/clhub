# Copy to .env next to compose.yaml on the NAS (/volume1/docker/clhub/.env),
# chmod 600, never committed. See docs/04-exploitation.md.

POSTGRES_PASSWORD=

# Must match POSTGRES_PASSWORD above — the app and the db container are
# configured separately so there's no templating step at deploy time.
DATABASE_URL=postgresql://clhub:CHANGE_ME@db:5432/clhub

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

RESEND_API_KEY=
MAIL_FROM=club@puzzpok.fr
APP_URL=https://clhub.puzzpok.fr

# Shared secret for the DSM Task Scheduler cron hitting POST /api/cron
# (reminders, expiration — see docs/04-exploitation.md §7). Generate the
# same way as BETTER_AUTH_SECRET above.
CRON_SECRET=
